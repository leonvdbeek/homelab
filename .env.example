# Copy to .env and fill in real values, then `set -a; source .env; set +a`.
# .env is gitignored.
#
# SSH access to PVE hosts is key-based (no password). Each host's
# authorized_keys is seeded by autopve's answer.toml on install. Make sure
# your local SSH key (or autopve's) is listed in
# stacks/autopve/storage-general.json's Default.global.root-ssh-keys.

# NetBox
NETBOX_URL=http://192.168.4.73:8484
NETBOX_TOKEN=nbt_KEY.TOKEN_FROM_PROVISION_ENDPOINT
NETBOX_SUPERUSER_PASSWORD=changeme
NETBOX_BOOTSTRAP_TOKEN=0000000000000000000000000000000000000000

# Proxmox VE — used by `tofu/talos`. Create the token in
# Datacenter → Permissions → API Tokens (untick Privilege Separation, or
# assign a role with VM/Datastore/Sys permissions). The full token string is
# `<user>@<realm>!<tokenid>=<uuid>`.
PROXMOX_VE_ENDPOINT=https://192.168.4.X:8006/
PROXMOX_VE_API_TOKEN=root@pam!tofu=00000000-0000-0000-0000-000000000000
PROXMOX_VE_INSECURE=true

# Mirror the endpoint for tofu variables (CSI helm release needs it).
TF_VAR_proxmox_endpoint=${PROXMOX_VE_ENDPOINT}
