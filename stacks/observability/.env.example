# Copy to .env on the portainer host alongside docker-compose.yml.
# Secrets — gitignored.

GF_SERVER_ROOT_URL=https://grafana.leonvdbeek.com

# SMTP — used for Grafana email alerts
GF_SMTP_ENABLED=true
GF_SMTP_HOST=smtp.gmail.com:587
GF_SMTP_USER=leonvandebeek@gmail.com
GF_SMTP_PASSWORD=app-password-here
GF_SMTP_FROM_ADDRESS=leonvandebeek@gmail.com
GF_SMTP_FROM_NAME=grafana
GF_SMTP_SKIP_VERIFY=false

# Authentik OAuth (generic OIDC)
GF_AUTH_OAUTH_AUTO_LOGIN=true
GF_AUTH_GENERIC_OAUTH_ENABLED=true
GF_AUTH_GENERIC_OAUTH_NAME=authentik
GF_AUTH_GENERIC_OAUTH_CLIENT_ID=...
GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET=...
GF_AUTH_GENERIC_OAUTH_SCOPES=openid profile email
GF_AUTH_GENERIC_OAUTH_AUTH_URL=https://authentik.leonvdbeek.com/application/o/authorize/
GF_AUTH_GENERIC_OAUTH_TOKEN_URL=https://authentik.leonvdbeek.com/application/o/token/
GF_AUTH_GENERIC_OAUTH_API_URL=https://authentik.leonvdbeek.com/application/o/userinfo/
GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH=contains(groups, 'Grafana Admins') && 'Admin' || contains(groups, 'Grafana Editors') && 'Editor' || 'Viewer'
GF_AUTH_SIGNOUT_REDIRECT_URL=https://authentik.leonvdbeek.com/application/o/grafana/end-session/
